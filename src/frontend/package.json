{
  "name": "@coupon/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-sites.mjs",
    "dev:sites": "node scripts/dev-sites.mjs",
    "dev:customer": "vite --config vite.customer.config.ts",
    "dev:operator": "vite --config vite.operator.config.ts",
    "dev:verifier": "vite --config vite.verifier.config.ts",
    "dev:admin": "vite --config vite.admin.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && npm run build:customer && npm run build:operator && npm run build:verifier && npm run build:admin",
    "build:customer": "vite build --config vite.customer.config.ts",
    "build:operator": "vite build --config vite.operator.config.ts",
    "build:verifier": "vite build --config vite.verifier.config.ts",
    "build:admin": "vite build --config vite.admin.config.ts",
    "preview:customer": "vite preview --config vite.customer.config.ts",
    "preview:operator": "vite preview --config vite.operator.config.ts",
    "preview:verifier": "vite preview --config vite.verifier.config.ts",
    "preview:admin": "vite preview --config vite.admin.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src sites --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@coupon/shared": "1.0.0",
    "@tanstack/react-query": "5.66.9",
    "antd": "5.24.8",
    "axios": "1.8.4",
    "dayjs": "1.11.13",
    "framer-motion": "10.18.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.0",
    "recharts": "2.15.1",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.13.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.21",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.19",
    "jsdom": "25.0.1",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "5.4.14",
    "vitest": "2.1.9"
  }
}

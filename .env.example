NODE_ENV=development
PORT=3000
DATABASE_FILE=./data/local-db.json
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
# 可选：设置后 operator/verifier 自助注册必须提交相同的员工注册码（至少 6 位）；customer 注册不受影响
# 留空表示三种角色都可以完全自助注册，任何人都能自行获取运营/核销后台权限
REGISTRATION_STAFF_CODE=
# 四个角色站点共用一个前端 origin，通过路径区分
CORS_ORIGIN=http://localhost:5173
AWS_REGION=us-east-1
BEDROCK_AUTH_MODE=sdk
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_API_KEY=
VITE_API_BASE_URL=http://localhost:3000/api/v1
# 可选：站点之间的同源路径；部署到子路径时可覆盖
VITE_SITE_CUSTOMER_URL=/customer
VITE_SITE_OPERATOR_URL=/operator
VITE_SITE_VERIFIER_URL=/verifier
VITE_SITE_ADMIN_URL=/admin

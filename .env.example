NODE_ENV=development
PORT=3000
DATABASE_FILE=./data/demo-db.json
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
# 四个角色站点各占一个 origin，按逗号分隔：用户主站/运营/核销/管理
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
AWS_REGION=us-east-1
BEDROCK_AUTH_MODE=sdk
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_API_KEY=
VITE_API_BASE_URL=http://localhost:3000/api/v1
# 站点之间的超链地址；部署到真实域名时覆盖这四项
VITE_SITE_CUSTOMER_URL=http://localhost:5173
VITE_SITE_OPERATOR_URL=http://localhost:5174
VITE_SITE_VERIFIER_URL=http://localhost:5175
VITE_SITE_ADMIN_URL=http://localhost:5176
